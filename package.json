{
  "name": "nutrition-diary-web",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --go",
    "start:lan": "expo start --go --lan",
    "start:tunnel": "expo start --go --tunnel",
    "test": "node --test nutrition.test.js energy.test.js",
    "export:ios": "expo export --platform ios",
    "export:android": "expo export --platform android",
    "build": "expo export --platform web --output-dir dist && node prepare-web.cjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.30",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "qrcode": "^1.5.4"
  }
}
